#!/bin/bash
cd "$(dirname "$0")"

# 如果已有残留进程，清理旧进程
lsof -ti :1098 | xargs kill -9 2>/dev/null

echo "=========================================================="
echo " 🚀 正在启动 强势股回调交易系统网页服务 (端口: 1098)..."
echo " 页面打开后，点击右上角【一键更新选股与行情】即可实时同步长桥数据！"
echo "=========================================================="

# 启动多线程服务并保持后台
python3 dashboard_server.py &
SERVER_PID=$!

sleep 1
# 自动打开浏览器
open "http://127.0.0.1:1098"

echo "服务已运行 (PID: $SERVER_PID)，请保持此终端窗口打开。"
wait $SERVER_PID
